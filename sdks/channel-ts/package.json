{
  "name": "@aura/channel-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "WebSocket + MessagePack channel SDK for Aura sidecars",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "gen:types": "cd ../.. && cargo test -p aura-channels --features ts-export --lib sdk::wire::export",
    "build": "tsc",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0-beta2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=21"
  }
}
