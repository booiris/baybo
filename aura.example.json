{
  "agent": {
    "max_iterations": 20,
    "context": {
      "max_tokens": 120000,
      "compression_threshold": 0.75,
      "keep_recent": 100
    }
  },
  "channels": {
    "cli": {
      "enabled": true
    },
    "message_buffer_size": 256
  },
  "security": {
    "encryption_key_file": "/home/YOUR_USER/.aura/.key/encryption.key",
    "leak_detection_enabled": true
  },
  "skills": {
    "risk_check": "primary"
  },
  "cost": {
    "spending_limits": {
      "daily_usd": null,
      "monthly_usd": null
    },
    "rate_limit": {
      "max_requests": 30,
      "window_secs": 60
    }
  },
  "workspace": {
    "path": "/home/YOUR_USER/.aura"
  },
  "gateway": {
    "enabled": false,
    "bind_address": "127.0.0.1",
    "port": 8888,
    "cors_allowed_origins": [],
    "shutdown_grace_secs": 30
  },
  "browser": {
    "enable": false,
    "sandbox": false,
    "width": 1920,
    "height": 1080,
    "docker": {
      "enable": false
    }
  }
}