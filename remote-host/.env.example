# ── remote-host (C role) deploy config ───────────────────────────────────────
# Copy to .env and fill in; `docker compose up -d --build` reads it.
# NEVER commit .env or the .p8 — both are gitignored.
#
# The relay is always on. The push role turns on automatically once you set the
# APNs section below; leave it blank for a relay-only deployment.

# ===== gateway admission =====
# Admitted keys are NOT configured here — they live in a SQLite table
# (./data/admission.db by default), hot-reloaded by polling. Add a key:
#   sqlite3 ./data/admission.db \
#     "INSERT INTO remote_api_keys(remote_api_key, label) VALUES('<key>', 'my gateway');"
# (The row defaults to tier='registered'. The table is created on first start.
#  See DEPLOY.md.)
# ADMISSION_DIR=./data                # host dir holding admission.db (mounted at /data)
# ADMISSION_POLL_SECS=30              # how often the table is re-read
# MAX_CONNS_PER_REMOTE_API_KEY=64     # fallback per-key connection cap; per-key
#                                       override via remote_api_keys.max_conns
#
# Content-relay bandwidth is two-level: a per-remote_api_key ceiling (default
# 1 MiB/s, override in remote_api_keys.max_bps, bytes/sec) AND a per-(key, server)
# sub-cap (override in remote_api_keys.per_server_max_bps). No env knob. The push
# /notify frequency control (60/min, burst 20, per device) is fixed in the binary.

# ===== push role (APNs) — fill to enable, leave blank to disable =====

# Host path to the APNs auth key (.p8) from the Apple Developer portal
# (Keys → APNs). Setting this turns the push role on; mounted read-only as a
# secret. Leave blank for a relay-only deployment.
APNS_P8_HOST_PATH=

# The .p8's 10-char Key ID (also embedded in the filename: AuthKey_<KeyID>.p8).
APNS_KEY_ID=

# Apple Developer Team ID.
APNS_TEAM_ID=

# App bundle id — sent as the APNs topic.
APNS_BUNDLE_ID=

# ===== optional listen port — host + container, default 7777 =====
# Set PORT=443 to serve on the standard port (the container runs as root, so a
# privileged port binds fine).
# PORT=7777

# ===== optional: serve wss/https instead of ws/http =====
# Set these to a PEM cert + key (e.g. Let's Encrypt, or a Cloudflare Origin cert
# when fronted by Cloudflare) and the listener serves TLS directly — no reverse
# proxy. Leave blank for plain ws/http. (One cert for the host serves both roles,
# since they share the one listener.)
# TLS_CERT_HOST_PATH=/etc/letsencrypt/live/c.example.com/fullchain.pem
# TLS_KEY_HOST_PATH=/etc/letsencrypt/live/c.example.com/privkey.pem

# ===== optional: per-source-IP relay-upgrade flood backstop (proxy posture) =====
# On by default, keyed on the socket peer — correct when this binary terminates
# TLS for the real client. Behind a proxy that terminates TLS (e.g. Cloudflare),
# the socket peer is the proxy edge, so all clients would share one IP bucket.
# Two ways to fix a proxied deployment:
#   (a) read the real client IP from the proxy's header (tried in order; first
#       parseable IP wins, else the socket peer):
# RELAY_CLIENT_IP_HEADERS=cf-connecting-ip
#   (or with a fallback)  RELAY_CLIENT_IP_HEADERS=cf-connecting-ip,x-forwarded-for
#   (b) disable here and rate-limit at the proxy instead:
# RELAY_PER_IP_LIMIT=0
#
# SECURITY: trust a client-IP header ONLY when this origin is reachable SOLELY via
# that proxy — a Cloudflare IP allowlist on :443, a cloudflared Tunnel (no public
# origin), or Authenticated Origin Pulls (CF mTLS). Otherwise a direct-to-origin
# attacker can forge cf-connecting-ip to evade the limit or frame an arbitrary IP.
