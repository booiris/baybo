# ── remote-host (C role) deploy config ───────────────────────────────────────
# Copy to .env and fill in; `docker compose up -d --build` reads it.
# NEVER commit .env or the .p8 — both are gitignored.

# ===== push role (APNs sender) =====

# Host path to the APNs auth key (.p8) you downloaded from the Apple Developer
# portal (Keys → APNs). Mounted read-only into the push container as a secret.
APNS_P8_HOST_PATH=./AuthKey_XXXXXXXXXX.p8

# The .p8's 10-char Key ID (also embedded in the filename: AuthKey_<KeyID>.p8).
APNS_KEY_ID=XXXXXXXXXX

# Apple Developer Team ID.
APNS_TEAM_ID=KLK5BP5YS6

# App bundle id — sent as the APNs topic.
APNS_BUNDLE_ID=com.baybo.app

# Comma-separated admission allow-list: the gateway instance_key(s) allowed to
# POST /notify + /register. Must match the gateway's baybo.json push.instance_key.
PUSH_INSTANCE_KEYS=change-me-gateway-key

# ===== relay role (blind pairing/content rendezvous) =====

# Comma-separated admission allow-list: gateway instance_key(s) allowed to host
# pairing/content legs + open the control connection. Must match the gateway's
# baybo.json relay.instance_key (often the same value as PUSH_INSTANCE_KEYS).
RELAY_INSTANCE_KEYS=change-me-gateway-key

# ===== optional host port mappings (defaults shown) =====
# PUSH_PORT=8443
# RELAY_PORT=8444
