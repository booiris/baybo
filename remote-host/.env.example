# ── remote-host (C role) deploy config ───────────────────────────────────────
# Copy to .env and adjust; `docker compose up -d --build` reads it.
# NEVER commit .env or the .p8 — both are gitignored.
#
# Every knob is listed as a live KEY=value line (no commented-out vars to miss).
# Numeric knobs are pre-filled with their built-in default — change as needed.
# Secrets / paths / behaviour-flips are left BLANK (a value changes behaviour, so
# blank = the safe default). The relay is always on; the push role turns on once
# the APNs section is filled, off while it's blank.

# ===== gateway admission =====
# Admitted keys are NOT configured here — they live in a SQLite table
# (admission.db under ADMISSION_DIR), hot-reloaded by polling. Add a key:
#   sqlite3 ./data/admission.db \
#     "INSERT INTO remote_api_keys(remote_api_key, label) VALUES('<key>', 'my gateway');"
# (The row defaults to tier='registered'. The table is created on first start.
#  See DEPLOY.md.) Per-key connection / bandwidth limits are columns on that table
# (max_conns / max_bps / per_server_max_bps), not env.
ADMISSION_DIR=./data                 # host dir holding admission.db (mounted at /data)
ADMISSION_POLL_SECS=30               # how often the table is re-read
MAX_CONNS_PER_REMOTE_API_KEY_FALLBACK=64  # fallback per-key connection cap (table overrides)

# ===== push role (APNs) — fill to enable, leave blank to disable =====
# Host path to the APNs auth key (.p8) from the Apple Developer portal
# (Keys → APNs); mounted read-only as a secret. Setting it turns the push role on.
APNS_P8_HOST_PATH=
APNS_KEY_ID=                         # the .p8's 10-char Key ID (also in its filename)
APNS_TEAM_ID=                        # Apple Developer Team ID
APNS_BUNDLE_ID=                      # app bundle id — sent as the APNs topic

# --- global push-limit overrides (defaults shown; only read when push is on) ---
PUSH_NOTIFY_RATE_PER_MIN=60          # per-device /notify sustained rate (pushes/min)
PUSH_NOTIFY_BURST=20                 # per-device /notify burst
PUSH_DEVICE_STORE_CAP=65536          # device-token store soft cap (bindings)
PUSH_UNCONFIRMED_TTL_SECS=3600       # evict an idle, never-/notify-confirmed binding after this
# The /register + /notify routes are keyless — authorized by the device delegation
# chain, not an admission key.

# ===== listen port — host + container =====
# 443 serves on the standard port (the container runs as root, so a privileged
# port binds fine).
PORT=7777

# ===== serve wss/https instead of ws/http (optional) =====
# Set BOTH to a PEM cert + key (Let's Encrypt, or a Cloudflare Origin cert when
# fronted by Cloudflare) to serve TLS directly — no reverse proxy. Leave both
# blank for plain ws/http. One cert serves both roles (shared listener).
TLS_CERT_HOST_PATH=
TLS_KEY_HOST_PATH=

# ===== per-source-IP flood backstop (ALWAYS ON; proxy posture) =====
# Keyed on the socket peer — correct when this binary terminates TLS for the real
# client. Behind a proxy that terminates TLS (e.g. Cloudflare) the socket peer is
# the proxy edge, so all clients would share one IP bucket — set CLIENT_IP_HEADERS
# to the proxy's real-client-IP header(s), tried in order (first parseable IP wins,
# else the socket peer):
#   CLIENT_IP_HEADERS=cf-connecting-ip
#   (with a fallback)  CLIENT_IP_HEADERS=cf-connecting-ip,x-forwarded-for
#
# SECURITY: trust a client-IP header ONLY when this origin is reachable SOLELY via
# that proxy — a Cloudflare IP allowlist on :443, a cloudflared Tunnel (no public
# origin), or Authenticated Origin Pulls (CF mTLS). Otherwise a direct-to-origin
# attacker can forge cf-connecting-ip to evade the limit or frame an arbitrary IP.
#
# Client-IP resolution is SHARED across both roles. Rate / burst / bucket-map cap
# are per role (relay's WS upgrades vs push's /register + /notify, separate maps).
# There is no disable switch — to neuter it behind a proxy that already rate-limits,
# set a very high rate/burst.
CLIENT_IP_HEADERS=                   # blank = socket peer; e.g. cf-connecting-ip behind a proxy
RELAY_IP_RATE_PER_SEC=10             # relay sustained per-IP rate (req/s)
RELAY_IP_BURST=60                    # relay per-IP burst
RELAY_IP_BUCKET_CAP=16384            # relay per-source-IP bucket-map soft cap
PUSH_IP_RATE_PER_SEC=10              # push sustained per-IP rate (req/s)
PUSH_IP_BURST=60                     # push per-IP burst
PUSH_IP_BUCKET_CAP=16384             # push per-source-IP bucket-map soft cap

# ===== logging =====
# Logs roll daily into LOG_DIR (on the /data volume, so they land on the host at
# ./data/logs and survive `up --build`), 14 daily files retained, also mirrored
# to `docker compose logs`. The hot path is silent — only session-level events
# (control connect/disconnect, limit backstops, admission changes) are logged.
# RUST_LOG tunes verbosity; blank = the built-in default below. This endpoint is
# public, so the default is deliberately quiet (deps at warn, our crates at info):
#   RUST_LOG=warn,remote_host=info,remote_host_relay=info,remote_host_push=info
# Quieter still (only problems): RUST_LOG=warn   |   Debug a gateway: append
# remote_host_relay=debug. Blank LOG_DIR is NOT valid here — set a path to relocate.
RUST_LOG=                            # blank = built-in default (quiet); see above
LOG_DIR=/data/logs                   # rolling-log dir on the /data volume

# ===== traffic ledger =====
# Per-tenant relay traffic (bytes + WS frames per remote_api_key × server_id, split
# up/down) and per-device push traffic (send count + bytes egressed) accumulate into
# a SQLite DB on the /data volume — a SEPARATE file from admission.db, so it survives
# `up --build` and is queryable with sqlite3 (see DEPLOY.md). The data path stays
# lock-free (atomic counters only); a background task flushes the running totals
# every TRAFFIC_FLUSH_SECS and reclaims idle counters. Set TRAFFIC_DB_PATH blank to
# keep the in-memory accounting but persist nothing.
TRAFFIC_DB_PATH=/data/traffic.db     # blank disables persistence (in-memory only)
TRAFFIC_FLUSH_SECS=60                # flush + eviction cadence (seconds)
