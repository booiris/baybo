# ── remote-host (C role) deploy config ───────────────────────────────────────
# Copy to .env and fill in; `docker compose up -d --build` reads it.
# NEVER commit .env or the .p8 — both are gitignored.
#
# The relay is always on. The push role turns on automatically once you set the
# APNs section below; leave it blank for a relay-only deployment.

# ===== gateway admission =====
# Admitted gateways are NOT configured here — they live in a SQLite table
# (./data/admission.db by default), hot-reloaded by polling. Add a gateway:
#   sqlite3 ./data/admission.db \
#     "INSERT INTO admitted_instances(instance_key, label) VALUES('<key>', 'my gateway');"
# (The table is created on first start. See DEPLOY.md.)
# ADMISSION_DIR=./data           # host dir holding admission.db (mounted at /data)
# ADMISSION_POLL_SECS=30         # how often the table is re-read
# MAX_CONNS_PER_INSTANCE=64      # cap on simultaneous relay connections per gateway

# ===== push role (APNs) — fill to enable, leave blank to disable =====

# Host path to the APNs auth key (.p8) from the Apple Developer portal
# (Keys → APNs). Setting this turns the push role on; mounted read-only as a
# secret. Leave blank for a relay-only deployment.
APNS_P8_HOST_PATH=

# The .p8's 10-char Key ID (also embedded in the filename: AuthKey_<KeyID>.p8).
APNS_KEY_ID=

# Apple Developer Team ID.
APNS_TEAM_ID=

# App bundle id — sent as the APNs topic.
APNS_BUNDLE_ID=

# ===== optional listen port — host + container, default 7777 =====
# Set PORT=443 to serve on the standard port (the container runs as root, so a
# privileged port binds fine).
# PORT=7777

# ===== optional: serve wss/https instead of ws/http =====
# Set these to a PEM cert + key (e.g. Let's Encrypt) and the listener serves TLS
# directly — no reverse proxy. Leave blank for plain ws/http. (One cert for the
# host serves both roles, since they share the one listener.)
# TLS_CERT_HOST_PATH=/etc/letsencrypt/live/c.example.com/fullchain.pem
# TLS_KEY_HOST_PATH=/etc/letsencrypt/live/c.example.com/privkey.pem
