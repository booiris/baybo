{
  "name": "@aura/tool-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser tool sidecar — wraps chrome-devtools-mcp as Aura's embedded stdio MCP server",
  "type": "module",
  "aura": {
    "domain": "tool",
    "kind": "mcp_server",
    "auxAssets": [
      { "src": "dist/cddm", "name": "cddm", "recursive": true },
      { "src": "docker", "name": "docker", "recursive": true }
    ]
  },
  "scripts": {
    "bundle": "node esbuild.config.mjs",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "install-chrome": "node scripts/install-chrome.mjs",
    "test": "node esbuild.config.mjs && node --test 'test/**/*.test.mjs'"
  },
  "dependencies": {
    "chrome-devtools-mcp": "0.23.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@puppeteer/browsers": "^2.13.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
