{
  "name": "@aura/tool-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser tool sidecar (Playwright + Chromium) — runs as an embedded stdio MCP server",
  "type": "module",
  "aura": {
    "domain": "tool",
    "kind": "mcp_server"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "node esbuild.config.mjs",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.config.mjs && node --test 'test/**/*.test.mjs'"
  },
  "dependencies": {
    "@aura/channel-sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.45.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=21"
  }
}
