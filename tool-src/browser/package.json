{
  "name": "@aura/tool-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser tool sidecar (Playwright + Chromium) for the Aura gateway",
  "type": "module",
  "aura": {
    "domain": "browser"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "node esbuild.config.mjs",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.config.mjs && node --test 'test/**/*.test.mjs'"
  },
  "dependencies": {
    "msgpackr": "^1.11.0",
    "playwright": "^1.45.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=21"
  }
}
