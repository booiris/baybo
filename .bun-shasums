# sha256 of each bun release zip for the versions tracked by
# `.bun-version`. Format matches oven-sh's upstream `SHASUMS256.txt` so
# you can copy-paste lines from their release page.
#
# `crates/gateway/build.rs` verifies the downloaded zip against the
# entry for the current `CARGO_CFG_TARGET_{OS,ARCH}`. Missing entries
# for a target emit a cargo:warning and skip verification; mismatches
# hard-fail the build.
#
# Bumping bun: update `.bun-version`, download the matching zip, record
# its sha256 here, and commit both files together.
cca9eb52762bbd81eb894fc8275bba0a0654e81aad318d19869854a30f3769a2  bun-darwin-aarch64.zip
c83ea4ef2126cc942056ff1958518181a2a5b6723d6aa57c96b5d0fb34d4b7dc  bun-darwin-x64.zip
1bad1671d05ba15696315ca7248ec043d29b595ff5fb15fa86b699c2255d8bc5  bun-linux-aarch64.zip
90e032a982ae299c62d645dac6caaa8eb00b69092bc8501bf13a590de8d099c8  bun-linux-x64.zip
