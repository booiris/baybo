{
  "llm": [
    {
      "name": "primary",
      "provider": "anthropic",
      "model": "claude-opus-4",
      "model_list": [
        { "model": "claude-opus-4" },
        { "model": "claude-sonnet-4" },
        {
          "model": "claude-haiku-4",
          "context_window": 200000,
          "pricing": {
            "input_per_1m_tokens": 1000000,
            "output_per_1m_tokens": 5000000
          }
        }
      ],
      "lite_model": "claude-haiku-4"
    }
  ],
  "default-llm": "primary",
  "agent": {
    "max_iterations": 300,
    "context": {
      "compression_threshold": 0.65,
      "keep_recent": 10
    }
  },
  "channels": {
    "cli": {
      "enabled": true
    },
    "message_buffer_size": 256
  },
  "security": {
    "encryption_key_file": "/home/YOUR_USER/.baybo/.key/encryption.key",
    "leak_detection_enabled": true
  },
  "skills": {
    "risk_check": "primary"
  },
  "cost": {
    "spending_limits": {
      "daily_usd": null,
      "monthly_usd": null
    },
    "rate_limit": {
      "max_requests": 30,
      "window_secs": 60
    }
  },
  "memory": {
    "builtin": {
      "enabled": true,
      "dream": {
        "schedule": "0 4 * * SUN,WED"
      }
    }
  },
  "workspace": {
    "path": "/home/YOUR_USER/.baybo"
  },
  "gateway": {
    "enabled": false,
    "bind_address": "127.0.0.1",
    "port": 8888,
    "cors_allowed_origins": [],
    "shutdown_grace_secs": 30
  },
  "browser": {
    "enable": false,
    "sandbox": false,
    "width": 1920,
    "height": 1080,
    "docker": {
      "enable": false,
      "mount_work_dir": true,
      "memory_limit_mb": 4096
    }
  },
  "external_agents": {
    "claude": {
      "enabled": true,
      "binary_path": null
    },
    "codex": {
      "enabled": true,
      "binary_path": null
    }
  },
  "permission": "auto",
  "proxy": {
    "url": "http://YOUR_PROXY_HOST:PORT",
    "no_proxy": ["example.com", ".internal"]
  }
}
