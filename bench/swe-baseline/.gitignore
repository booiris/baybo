# Scratch + generated artifacts (regenerated by run.sh):
#   runs/    — mini-swe-agent output (preds.json, per-instance trajectories) +
#              the swebench harness report (<model>.<run_id>.json) + its logs/
#   results/ — the shaped per-run results-baseline-<run_id>.json report
#   mini-config/ — scratch MSWEA global config dir (isolates from host state)
/runs/
/results/
/mini-config/
# Local secrets / overrides.
/.env
__pycache__/
# uv-managed virtualenv (rebuilt by `uv sync`); uv.lock + pyproject.toml +
# .python-version ARE tracked.
/.venv/
