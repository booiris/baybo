#!/bin/bash
# Installed by AuraAgent. The `aura` binary and `aura.json` were already copied
# into /installed-agent by the adapter's perform_task; this script puts the
# binary on PATH and mints a per-container key for aura's secret vault.
set -e
install -m 0755 /installed-agent/aura /usr/local/bin/aura
mkdir -p /installed-agent/aura-home
od -An -tx1 -N32 /dev/urandom | tr -d ' \n' > /installed-agent/enc.key

# aura needs `git` (it inits the workspace's identity repos at startup) and TLS
# roots for the HTTPS call to the LLM. Most task images already have them; only
# install when git is absent, to avoid a slow package-index refresh per task.
# Best-effort across the common base images — a failed install isn't fatal here
# (aura will surface a clear error at startup if git is genuinely missing).
if ! command -v git >/dev/null 2>&1; then
    if command -v apt-get >/dev/null 2>&1; then
        apt-get update -qq && apt-get install -y -qq git ca-certificates >/dev/null 2>&1 || true
    elif command -v apk >/dev/null 2>&1; then
        apk add --no-cache git ca-certificates >/dev/null 2>&1 || true
    elif command -v dnf >/dev/null 2>&1; then
        dnf install -y -q git ca-certificates >/dev/null 2>&1 || true
    fi
fi
