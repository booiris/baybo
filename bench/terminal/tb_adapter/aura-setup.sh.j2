#!/bin/bash
# Installed by AuraAgent. The `aura` binary and `aura.json` were already copied
# into /installed-agent by the adapter's perform_task; this script puts the
# binary on PATH and mints a per-container key for aura's secret vault.
set -e
install -m 0755 /installed-agent/aura /usr/local/bin/aura
mkdir -p /installed-agent/aura-home
od -An -tx1 -N32 /dev/urandom | tr -d ' \n' > /installed-agent/enc.key

# aura needs TLS roots for the HTTPS call to the LLM. The base images ship
# ca-certificates, so this is normally a no-op; only refresh+install when a task
# image genuinely lacks them — a per-task `apt-get update` is slow on a weak
# network and otherwise pointless. (`git` is no longer needed: a `bench-bash`
# build skips the workspace identity-repo init.) Best-effort — a failed install
# isn't fatal.
if [ ! -f /etc/ssl/certs/ca-certificates.crt ]; then
    if command -v apt-get >/dev/null 2>&1; then
        apt-get update -qq && apt-get install -y -qq ca-certificates >/dev/null 2>&1 || true
    elif command -v apk >/dev/null 2>&1; then
        apk add --no-cache ca-certificates >/dev/null 2>&1 || true
    elif command -v dnf >/dev/null 2>&1; then
        dnf install -y -q ca-certificates >/dev/null 2>&1 || true
    fi
fi
