# Provider key file + any backup (e.g. .env.bak from an env migration). Never commit.
/.env
/.env.bak

# Python adapter bytecode (tb_adapter/).
__pycache__/
*.pyc

# uv-managed virtualenv (the lockfile IS committed for reproducibility).
/.venv/

# `tb run` output (its results.json + asciinema casts + logs), regenerated each run.
/runs/
# The report, surfaced from the newest runs/<ts>/results.json by run.sh.
/results/

# Per-task aura transcripts + call-tree traces (mirrors the runs/ task path).
/trace/
