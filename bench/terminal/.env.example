# Environment for `tb run` with the aura installed-agent adapter.
#
# Export these (or `source` this file) before running — the adapter reads them
# from the live environment; it does NOT auto-load this file. Copy to `.env`
# (gitignored) and fill in. The only thing you must set is the API key.

# API key for the provider under test. AURA_TB_API_KEY is provider-agnostic; or
# set the provider's own env var instead (DEEPSEEK_API_KEY / OPENAI_API_KEY /
# ANTHROPIC_API_KEY / GEMINI_API_KEY / OPENROUTER_API_KEY).
AURA_TB_API_KEY=

# Model under test, as `<provider>/<model>`. Either set this or pass the same
# value to `tb run --model` (the CLI flag wins; the harness also uses it for run
# naming, so passing --model is recommended). Known providers:
#   deepseek · openai · anthropic · gemini (or google) · openrouter
AURA_TB_MODEL=gemini/gemini-2.5-flash

# OPTIONAL — custom endpoint for the provider (a proxy, a self-hosted /
# OpenAI-compatible server, a gateway). Empty = the provider's built-in URL.
AURA_TB_BASE_URL=

# OPTIONAL — the `aura` binary to run in-container. Defaults to the musl build
# output (`target/x86_64-unknown-linux-musl/release/aura`, see README → "Build
# the binary"); set this only to point at a different build or location.
#AURA_TB_BINARY=
