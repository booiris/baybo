# Memory benchmark env — copy to `.env` (gitignored) and fill in.
#   cp bench/memory/.env.example bench/memory/.env
# run-bench.sh auto-loads ./.env; docker-compose reads it for the OpenViking
# container; ov.conf references the OPENVIKING_* / DEEPSEEK_* vars via ${...}.
# Unquoted on purpose (Compose env_file keeps literal quotes). Every var below
# must stay present even if empty — an *unset* var leaves a literal "${...}" in
# ov.conf.

# DeepSeek API key — used by the judge, the default answer model, AND
# OpenViking's extraction LLM (vlm).
DEEPSEEK_API_KEY=

# The LLM Aura answers with (self-contained config only; ignored when AURA_CONFIG
# points at your own aura.json — then its default-llm wins). The defaults below
# work out of the box with the DEEPSEEK_API_KEY above. To benchmark another
# provider, change these and add its key here — e.g. AURA_ANSWER_PROVIDER=openai,
# AURA_ANSWER_MODEL=gpt-4o, AURA_ANSWER_API_KEY_ENV=OPENAI_API_KEY, plus OPENAI_API_KEY=...
AURA_ANSWER_PROVIDER=deepseek
AURA_ANSWER_MODEL=deepseek-v4-pro
AURA_ANSWER_API_KEY_ENV=DEEPSEEK_API_KEY
AURA_ANSWER_BASE_URL=  # empty = the provider's built-in endpoint

# OpenViking server (the Docker container) auth: api_key mode is required
# because the server refuses unauthenticated "dev" mode on 0.0.0.0. One token —
# ov.conf's root_api_key reads it; bench ingest + the agent send it. Any local
# string is fine.
OPENVIKING_API_KEY=ovk-local-bench-dev-key

# Embedding endpoint (OpenAI-compatible) — shared by BOTH arms: OpenViking's
# ov.conf and the self-hosted mem0 server. URL is the *base* (ends in /v1; the
# client appends /embeddings). Key may be empty for a keyless local server.
# From inside a container a host server is host.docker.internal.
OPENVIKING_EMBEDDING_MODEL=Qwen3-Embedding-4B-4bit-DWQ
OPENVIKING_EMBEDDING_URL=http://host.docker.internal:8001/v1
OPENVIKING_EMBEDDING_API_KEY=
# Embedding output width — MUST match the model. Single source of truth for
# both ov.conf's vectordb dimension and the mem0 server's qdrant collection.
OPENVIKING_EMBEDDING_DIMS=2560

# OpenViking extraction LLM (ov.conf vlm). Defaults are standard DeepSeek;
# change both if you use a proxy / custom endpoint.
OPENVIKING_VLM_MODEL=deepseek-v4-flash
OPENVIKING_VLM_API_BASE=https://api.deepseek.com
