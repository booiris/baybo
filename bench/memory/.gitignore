# OpenViking runtime data: vector DB + extracted memories (mounted by
# docker-compose at ./data → /app/.openviking/data). Not source.
/data/
# Benchmark scratch: downloaded dataset + ingest manifests. Result JSONs are
# tracked (committed under results/), not here.
/bench-out/
# Per-run aura workspaces the bench generates (config + vault + sessions.db +
# logs). Disposable scratch, regenerated each run.
/aura-ws/
# Self-hosted mem0 arm's qdrant vector store (docker volume mount).
/mem0-data/
