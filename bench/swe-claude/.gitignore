# Scratch + generated artifacts (regenerated by run.sh):
#   runs/    — per-instance predictions.jsonl + the swebench harness report + logs/
#   results/ — the shaped per-run results-claude-<run_id>.json report
#   proxy/   — litellm proxy logs/pidfile
#   trace/   — per-instance .messages.json transcripts (aura format)
/runs/
/results/
/proxy/
/trace/
# Local secrets / overrides.
/.env
__pycache__/
# uv-managed virtualenv (rebuilt by `uv sync`); uv.lock + pyproject.toml +
# .python-version ARE tracked.
/.venv/
