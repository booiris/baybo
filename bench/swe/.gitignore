# Scratch + generated artifacts (all regenerated by run-bench.sh):
#   bench-out*/ — exported instances.json (+ per-run variants: bench-out-run210, …)
#   results/   — the per-run results-<arm>-<run_id>.json report (embeds full patches)
#   runs/      — run working artifacts: predictions.jsonl, the swebench harness
#                report (<model>.<run_id>.json) + its logs/
/bench-out*/
/results/
/runs/
# Per-run transcripts + call-tree traces (regenerated; embed full conversations).
/trace/
# Local secrets / overrides.
/.env
# Python bytecode from swe_export.py.
__pycache__/
# uv-managed virtualenv (persistent, rebuilt by `uv sync`); the lockfile + the
# pinned-version files (uv.lock, pyproject.toml, .python-version) ARE tracked.
/.venv/
