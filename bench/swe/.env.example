# Environment for the SWE-bench agent arm. Auto-loaded (and exported) by
# run-bench.sh — copy to bench/swe/.env (gitignored) and fill in BAYBO_API_KEY.
# Only the AGENT arm needs a key; noop/oracle run with none.
#
# Run-time knobs (which arms, dataset/split, instance selection, concurrency,
# timeouts, the baybo binary, the python interpreter) have sane defaults — see
# run-bench.sh and pass them inline, e.g.
#   ARMS="noop oracle agent" INSTANCE_IDS="sympy__sympy-20590" bench/swe/run-bench.sh

# API key for the agent arm — the one required value.
BAYBO_API_KEY=

# Optional — leave empty to use the default shown in the comment:
BAYBO_MODEL=     # deepseek/deepseek-v4-flash  (<provider>/<model>: openai/gpt-4o, anthropic/claude-3-5-sonnet, gemini/gemini-2.5-flash, …)
BAYBO_BASE_URL=  # provider's built-in endpoint  (set for a proxy / self-hosted / gateway)
