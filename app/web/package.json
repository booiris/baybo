{
  "name": "baybo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run gen:api && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
