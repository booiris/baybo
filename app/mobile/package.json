{
  "name": "baybo-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../../docs/openapi.json -o src/generated/schema.d.ts",
    "build": "pnpm run gen:api && tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-env.mjs",
    "ios:build": "node scripts/tauri-env.mjs ios build --export-method debugging",
    "ios:install": "node scripts/ios-install.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/space-mono": "^5.2.9",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-barcode-scanner": "^2.2.0",
    "@tauri-apps/plugin-haptics": "^2.2.0",
    "i18next": "^26.3.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "openapi-typescript": "^7.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
