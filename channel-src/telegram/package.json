{
  "name": "@aura/channel-telegram",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram channel sidecar for the Aura gateway",
  "type": "module",
  "bin": {
    "aura-channel-telegram": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/bundle.mjs --banner:js=\"import{createRequire as __aR}from'node:module';const require=__aR(import.meta.url);\"",
    "check": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "node --test 'test/**/*.test.mjs'"
  },
  "dependencies": {
    "@aura/channel-sdk": "workspace:*",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=21"
  }
}
