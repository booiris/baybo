# Required. Copy this file to .env and fill in the provider API key.
BAYBO_LLM_API_KEY=

# The generated config uses these values only on the first boot.
BAYBO_LLM_NAME=primary
BAYBO_LLM_PROVIDER=deepseek
BAYBO_LLM_MODEL=deepseek-chat
BAYBO_LLM_BASE_URL=
BAYBO_REASONING_EFFORT=medium
BAYBO_PERMISSION=auto
BAYBO_BROWSER_ENABLE=false

# Host-side HTTP port. Baybo always listens on 8888 inside the container.
BAYBO_HTTP_PORT=8888
RUST_LOG=baybo=info
